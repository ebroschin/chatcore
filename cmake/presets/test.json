{
  "version": 6,
  "include": [
    "base.json",
    "arch.json",
    "gcc.json",
    "clang.json",
    "msvc.json"
  ],
  "configurePresets": [
    {
      "name": "test-all",
      "hidden": true,
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "test;client"
      }
    },
    {
      "name": "linux-clang-test-all",
      "inherits": ["linux-debug", "linux-x64", "clang", "test-all"],
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
      }
    },
    {
      "name": "linux-clang-x86-test-all",
      "inherits": ["linux-debug", "linux-x86", "clang", "test-all"],
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
      }
    },
    {
      "name": "linux-gcc-test-all",
      "inherits": ["linux-debug", "linux-x64", "gcc", "test-all"]
    },
    {
      "name": "linux-gcc-x86-test-all",
      "inherits": ["linux-debug", "linux-x86", "gcc", "test-all"]
    },
    {
      "name": "linux-gcc-arm64-test-all",
      "inherits": ["linux-debug", "linux-arm64", "gcc", "test-all"]
    },
    {
      "name": "windows-msvc-test-all",
      "inherits": ["windows-release", "windows-x64", "msvc", "test-all"]
    },
    {
      "name": "windows-msvc-x86-test-all",
      "inherits": ["windows-release", "windows-x86", "msvc", "test-all"]
    },
    {
      "name": "windows-msvc-arm64-test-all",
      "inherits": ["windows-release", "windows-arm64", "msvc", "test-all"]
    },
    {
      "name": "windows-clang-test-all",
      "inherits": ["windows-release", "windows-x64", "windows-clang", "test-all"]
    },
    {
      "name": "windows-clang-x86-test-all",
      "inherits": ["windows-release", "windows-x86", "windows-clang", "test-all"]
    },
    {
      "name": "windows-mingw-test-all",
      "inherits": ["windows-release", "mingw", "test-all"]
    }
  ]
}

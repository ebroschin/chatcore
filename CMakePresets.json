{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang"
      }
    },
    {
      "name": "linux-debug-client",
      "inherits": "linux-debug",
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "OFF",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "linux-debug-server",
      "inherits": "linux-debug",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "build-linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "test-linux-debug",
      "configurePreset": "linux-debug"
    }
  ]
}
{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/third_party/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-20",
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS_DEBUG": "-g -O0 -fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0 -fsanitize=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-20",
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang"
      }
    },
    {
      "name": "linux-debug-client",
      "inherits": "linux-debug",
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "OFF",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "linux-release-client",
      "inherits": "linux-release",
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "OFF",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "linux-debug-server",
      "inherits": "linux-debug",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "OFF"
      }
    },
    {
      "name": "linux-release-server",
      "inherits": "linux-release",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "OFF"
      }
    },
    {
      "name": "linux-debug-load-tester",
      "inherits": "linux-debug",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "ON"
      }
    },
    {
      "name": "linux-release-load-tester",
      "inherits": "linux-release",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "ON"
      }
    },
    {
      "name": "linux-test-all",
      "inherits": "linux-debug",
      "cacheVariables": {
        "CMAKE_CXX_CLANG_TIDY": "clang-tidy-20",
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "test;client"
      }
    },
    {
      "name": "linux-release-all",
      "inherits": "linux-release",
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "ON",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "windows-release-client",
      "inherits": "windows-release",
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "OFF",
        "VCPKG_MANIFEST_FEATURES": "client"
      }
    },
    {
      "name": "windows-release-server",
      "inherits": "windows-release",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "OFF"
      }
    },
    {
      "name": "windows-test-all",
      "inherits": "windows-release",
      "cacheVariables": {
        "BUILD_CLIENT": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_LOAD_TESTER": "ON",
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "test;client"
      }
    },
    {
      "name": "windows-release-load-tester",
      "inherits": "windows-release",
      "cacheVariables": {
        "BUILD_CLIENT": "OFF",
        "BUILD_SERVER": "OFF",
        "BUILD_LOAD_TESTER": "ON"
      }
    }
  ]
}